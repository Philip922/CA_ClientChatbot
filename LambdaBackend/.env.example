# --- LLM (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4-6
LLM_TEMPERATURE=0.2
REQUEST_TIMEOUT=30

# --- Agent loop ------------------------------------------------------------
MAX_ITERATIONS=3
BOOKING_LINK=https://cadreai.com/book

# --- Scraper ---------------------------------------------------------------
CADRE_WEBSITE_URL=https://cadreai.com
SCRAPE_CACHE_TTL=3600
SCRAPE_MAX_CHARS=4000

# --- RAG -------------------------------------------------------------------
# `hosted` calls an OpenAI-compatible /embeddings endpoint (the only backend
# that fits in a Lambda zip). `local` uses sentence-transformers and is for
# offline index builds and tests only.
EMBEDDING_BACKEND=hosted
# OpenRouter serves embeddings too, so the default needs no second account:
# leave EMBEDDINGS_API_KEY blank and OPENROUTER_API_KEY is used. Models are
# provider-prefixed here (openai/..., mistral/...).
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
# To use another provider instead, set all three together, e.g.
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#   EMBEDDINGS_API_KEY=sk-proj-...
INDEX_PATH=rag_index.npz
DOCUMENTS_DIR=documents
# Cosine-similarity floor. Tune per embedding model — see README.
RAG_MIN_SCORE=0.35
RAG_TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- HTTP ------------------------------------------------------------------
CORS_ALLOW_ORIGIN=*
